generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String 
  cat String
  price       String 
}

model Cat {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String 
}

model Service {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String 
  img         String[]  
}

model ServiceData {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  serviceId   String   @db.ObjectId
  title       String
  description String
  img         String[]
}

model New {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String 
  img         String[]  
}

model Extension {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String 
  img         String[]  
}

model Appointment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  info       Json  
}

 

 

model Order {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String
  email     String
  country   String
  city      String 
  date      String  
  hour      String  
  cart      Json
  total     String
 paid        Boolean @default(false)
  // Salon / home service and tax (missing on older bookings)
  serviceType String?
  subtotal    String?
  homeFee     String?
  taxPercent  String?
  tax         String?
}

// Appointment tax: a single percentage, added to every booking total
// (salon and home service alike). Set from the dashboard's Tax page.
model Tax {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  percent Float  @default(0)
}


 
model Video {
  id   String   @id @default(auto()) @map("_id") @db.ObjectId 
  img  String[]
}

model New1 {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String 
}





model Product1 {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String 
  description  String?
  price        String?
  discount     String?
  img          String[]
  category     String
  stock        String? 
  color        Json?
  type         String
  arrival      String   @default("no")
  cost         String?
  sub          String
  factory      String
  sale         String?
  // Kept unique by the API; not @unique, because a Mongo unique index
  // would reject every existing product that has no barcode yet.
  barcode      String?
}

model Category1 {
  id   String   @id @default(auto()) @map("_id") @db.ObjectId
  name String   @unique
  img  String[] 
}

model Sub1 {
  id   String   @id @default(auto()) @map("_id") @db.ObjectId
  name String   @unique 
  img  String[] 
}

model Factory1 {
  id   String   @id @default(auto()) @map("_id") @db.ObjectId
  name String   @unique
  img  String[] 
}

model Offer {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  code String
  per  Int
}

model Ad {
  id  String   @id @default(auto()) @map("_id") @db.ObjectId
  url String
  img String[]
}

// About page banner: one image, shown full width at the top of the page.
model AboutBanner {
  id  String @id @default(auto()) @map("_id") @db.ObjectId
  img String
}

model Order1 {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  oid         Int     @unique
  userInfo    Json
  cartItems   Json
  total       String
  delivery    String
  code        String?
  paid        Boolean @default(false)
  num         String?
  remark      String?
  fulfillment Boolean @default(false)
  date        String
  delete      Boolean @default(false)
}

// ───────────────── Customer accounts / wishlist / reviews ─────────────────

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  password  String            // bcrypt hash
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favorites Favorite[]
  reviews   Review[]
}

model Favorite {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  productId String   @db.ObjectId
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  productId String   @db.ObjectId
  userId    String   @db.ObjectId
  userName  String
  rating    Int                // 1..5
  title     String?
  comment   String
  verified  Boolean  @default(false)
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}