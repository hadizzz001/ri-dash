generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String 
  cat String
  price       String 
}

model Cat {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String 
}

model Service {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String 
  img         String[]  
}

model New {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String 
  img         String[]  
}

model Extension {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String 
  img         String[]  
}

model Appointment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  info       Json  
}

 

 

model Order {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String
  email     String
  country   String
  city      String 
  date      String  
  hour      String  
  cart      Json  
  total     String
 paid        Boolean @default(false)
 
}


 
model Video {
  id   String   @id @default(auto()) @map("_id") @db.ObjectId 
  img  String[]
}